# Supabase (required)
# Get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (admin actions: password reset, signed file URLs for PIC)
# Same dashboard → API → service_role key (keep secret)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: app timezone for "today" (default: Asia/Kuala_Lumpur)
# NEXT_PUBLIC_APP_TIMEZONE=Asia/Kuala_Lumpur
